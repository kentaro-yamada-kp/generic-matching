# Node Environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL / Docker / RDS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=generic_matching
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/generic_matching?schema=public"

# Auth (NextAuth / Auth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-long"

